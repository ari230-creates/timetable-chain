/* Light Theme Stylesheet */

* {
    font-size: 13px;
    color: #1B1F3B;
}

QMainWindow, QDialog {
    background-color: #F6F7FB;
}

QWidget#CentralWidget, QWidget#BackgroundWidget,
QWidget#GeneratorPage, QWidget#ManualBuilderPage,
QWidget#BlockchainPage, QWidget#DataPage,
QStackedWidget#StackedWidget {
    background-color: #F6F7FB;
}

/* Sidebar styling */
QWidget#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E7F0;
}

QPushButton.nav-btn {
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #6B7194;
    background-color: transparent;
}

QPushButton.nav-btn:hover {
    background-color: #F0F2FA;
    color: #1B1F3B;
}

QPushButton.nav-btn[active="true"] {
    background-color: #EEF0FD;
    color: #5B5BD6;
    font-weight: 600;
}

/* Top bar styling */
QWidget#TopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E7F0;
}

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1B1F3B;
}

QLabel#StatusChip {
    background-color: #EEF0FD;
    color: #5B5BD6;
    border: 1px solid #D6D8F8;
    border-radius: 12px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 12px;
}

/* Card components */
QFrame.card, QWidget.card {
    background-color: #FFFFFF;
    border: 1px solid #E4E7F0;
    border-radius: 12px;
}

QLabel.stat-title {
    font-size: 12px;
    font-weight: 600;
    color: #6B7194;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel.stat-value {
    font-size: 28px;
    font-weight: 800;
    color: #1B1F3B;
}

QLabel.stat-sub {
    font-size: 11px;
    color: #6B7194;
}

/* Buttons */
QPushButton {
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
    border: 1px solid #E4E7F0;
    background-color: #FFFFFF;
    color: #1B1F3B;
}

QPushButton:hover {
    background-color: #F6F7FB;
    border-color: #CBD0E1;
}

QPushButton.primary-btn {
    background-color: #5B5BD6;
    color: #FFFFFF;
    border: 1px solid #5B5BD6;
}

QPushButton.primary-btn:hover {
    background-color: #4C4CBF;
    border-color: #4C4CBF;
}

QPushButton.secondary-btn {
    background-color: transparent;
    color: #5B5BD6;
    border: 1px solid #5B5BD6;
}

QPushButton.secondary-btn:hover {
    background-color: #EEF0FD;
}

QPushButton.danger-btn {
    background-color: #D64545;
    color: #FFFFFF;
    border: 1px solid #D64545;
}

QPushButton.danger-btn:hover {
    background-color: #BE3A3A;
}

/* Inputs & Combos */
QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E4E7F0;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1B1F3B;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #5B5BD6;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1B1F3B;
    border: 1px solid #E4E7F0;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #EEF0FD;
    selection-color: #5B5BD6;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    color: #1B1F3B;
    background-color: #FFFFFF;
    border-radius: 6px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #EEF0FD;
    color: #5B5BD6;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #EEF0FD;
    color: #5B5BD6;
}

/* Table views */
QHeaderView {
    background-color: #FFFFFF;
    border: none;
}

QTableWidget, QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E4E7F0;
    border-radius: 12px;
    gridline-color: #F0F2F7;
    selection-background-color: #EEF0FD;
    selection-color: #1B1F3B;
}

QHeaderView::section {
    background-color: #F8F9FD;
    color: #6B7194;
    font-weight: 600;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #E4E7F0;
    border-right: 1px solid #E4E7F0;
    padding: 8px 12px;
}

QTableCornerButton::section {
    background-color: #F8F9FD;
    border: none;
    border-bottom: 1px solid #E4E7F0;
    border-right: 1px solid #E4E7F0;
}

/* Scroll Area & Container transparent background */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollArea QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QWidget#BlockCardsContainer {
    background: transparent;
}

/* Tab Widget (Data page) */
QTabWidget::pane {
    border: 1px solid #E4E7F0;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #EEF0FD;
    color: #6B7194;
    padding: 8px 16px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #5B5BD6;
    color: #FFFFFF;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F6F7FB;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #D2D5E3;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #ACB1C6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #F6F7FB;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #D2D5E3;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E4E7F0;
    color: #6B7194;
    font-size: 12px;
}
